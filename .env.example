PORT=23452
DATABASE_URL=postgres://vpn:vpn@localhost:5432/vpn_sub?sslmode=disable
GIN_MODE=debug
IMAGE=vpn_subscription_service:latest

# Админ-API: Authorization: Bearer <ADMIN_TOKEN>
ADMIN_TOKEN=change-me

# 3x-ui: базовый URL = host:port + webBasePath (из OpenAPI servers.url, напр. /babaduk).
# Порт панели часто HTTPS — тогда схема https://.
# Пример: https://172.17.0.1:6217/babaduk
XUI_BASE_URL=https://172.17.0.1:6217/babaduk
XUI_API_TOKEN=
# true если HTTPS на IP (сертификат на домен) — как curl -k
XUI_INSECURE_SKIP_VERIFY=true
PUBLIC_BASE_URL=http://127.0.0.1:23452

# Имя внешней docker-сети, где крутится 3x-ui (см. README: docker inspect)
XUI_DOCKER_NETWORK=3xui_default

# --- Secret invite landing (оставь пустым = лендинг выключен) ---
# Сгенерируй свои UID и НЕ коммить боевые значения.
INVITE_GATE_UID=6097e8d4293cdae0f33b1d5913e609d2
INVITE_PAGE_UID=e6a30db18a28fcad0b420bd8b220b629
INVITE_ADMIN_UID=fb3490dcd62446892f012ee930f13921
INVITE_TZ=Europe/Saratov
INVITE_REVEAL_AT=2026-09-25T20:00:00
INVITE_VIDEO_PATH=/data/invite/card.mp4
TZ=Europe/Saratov
